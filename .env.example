# Application
APP_ENV=development
SITE_BASE_URL=http://127.0.0.1:8000
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE=604800
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_REQUEST_BYTES=52500000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
REDIS_URL=
# Production always requires MFA for privileged routes. Set true to test in staging.
PRIVILEGED_MFA_REQUIRED=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
ASSET_VERSION=20261009-release30

# Demo/staging snapshots only; NOT a production financial database.
# Setting Supabase API keys does not replace this with a Postgres repository.
STATE_DB_PATH=
# PostgreSQL runtime storage. Apply `python -m app.database migrate` first.
# Use a direct or SESSION-pool connection. Transaction poolers are unsupported.
# Do not import demo snapshots into this database. Required in production.
DATABASE_URL=
# Optional separate libpq password; DATABASE_URL must omit its password when used.
# Keep this server-only/sealed. Never paste a real password into this example.
PGPASSWORD=
PRIVATE_STORAGE_PATH=/data/private_uploads
CLAMAV_HOST=
CLAMAV_PORT=3310

# Supabase authentication, Postgres and private storage
SUPABASE_URL=
# Preferred current API keys, server secret must remain sealed/server-only.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Compatibility with existing deployments. New names above take precedence.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect, Checkout, Identity and signed webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Sandbox only. The JPY one-time payout worker requires separate charges.
# Live writes remain blocked until external acceptance tests/operations approval.
STRIPE_CHARGE_MODE=separate
# Pin the API contract used by the backend; update deliberately after testing.
STRIPE_API_VERSION=2026-02-25.clover
# Enable only after Accounts v2 onboarding has been verified in Stripe Sandbox.
STRIPE_CONNECT_ACCOUNTS_V2=false

# Proposed fee/payout policy (bank payout integration and legal review pending)
PLATFORM_FEE_RATE=0.15
CUSTOM_FEE_RATE=0.18
PAYOUT_MINIMUM=161
PAYOUT_FEE=160
PAYOUT_FEE_FREE_THRESHOLD=3000
PAYOUT_AUTO_DAYS=120
# 120 is a legacy DEMO proposal, NOT an approved live holding period.
# Stripe manual payouts in Japan generally require payout within 90 days.
# Automatic expiry payouts remain disabled outside demo pending policy review.

# Resend transactional email
EMAIL_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Monitoring and operations
SENTRY_DSN=
ADMIN_USER_IDS=

# Required legal operator information
LEGAL_BUSINESS_NAME=合同会社ONE
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_WEBSITE=
# 未登録・未確認のまま推測値を入れないこと
LEGAL_INVOICE_NUMBER=
