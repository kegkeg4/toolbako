# Application
APP_ENV=development
SITE_BASE_URL=http://127.0.0.1:8000
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE=604800
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_REQUEST_BYTES=52500000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
ASSET_VERSION=20260716-release22

# Durable state: local/single-instance option. In hosted environments this path
# must be on a persistent volume. Prefer Supabase for multi-instance production.
STATE_DB_PATH=
PRIVATE_STORAGE_PATH=/data/private_uploads
CLAMAV_HOST=
CLAMAV_PORT=3310

# Supabase authentication, Postgres and private storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect, Checkout, Identity and signed webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Keep `destination` until the production payout worker is live. Set `separate`
# to hold seller funds in ONE and release them with an explicit Transfer.
STRIPE_CHARGE_MODE=destination
# Pin the API contract used by the backend; update deliberately after testing.
STRIPE_API_VERSION=2026-02-25.clover
# Enable only after Accounts v2 onboarding has been verified in Stripe Sandbox.
STRIPE_CONNECT_ACCOUNTS_V2=false

# Resend transactional email
EMAIL_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Monitoring and operations
SENTRY_DSN=
ADMIN_USER_IDS=

# Required legal operator information
LEGAL_BUSINESS_NAME=合同会社ONE
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_WEBSITE=
# 未登録・未確認のまま推測値を入れないこと
LEGAL_INVOICE_NUMBER=
