{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK" },
  "deploy": {
    "startCommand": "python -m app.live_runtime web",
    "preDeployCommand": ["python -m app.live_runtime preflight"],
    "healthcheckPath": "/deploymentz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
